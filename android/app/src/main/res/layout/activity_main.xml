<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/puxarAtualizar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fundo" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Barra fina de carregamento no topo -->
    <ProgressBar
        android:id="@+id/progresso"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/roxo"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <!-- Tela de sem conexão -->
    <LinearLayout
        android:id="@+id/telaOffline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fundo"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_splash" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/offline_titulo"
            android:textColor="@color/texto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/offline_texto"
            android:textColor="@color/texto_2"
            android:textSize="15sp" />

        <Button
            android:id="@+id/botaoTentar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/botao_marca"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/offline_botao"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
