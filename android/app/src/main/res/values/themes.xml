<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tela de abertura (splash) -->
    <style name="Theme.Retroway.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fundo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Retroway</item>
    </style>

    <!-- Tema do app -->
    <style name="Theme.Retroway" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:colorAccent">@color/roxo</item>
        <item name="android:colorPrimary">@color/roxo</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
