# Fotos de perfil: só imagens, nunca código
Options -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .asp
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(?i:php|phtml|php\d|phar|pl|py|cgi|asp|sh|html?|js)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# SVG só o avatar padrão (SVG enviado por usuário poderia ter código)
<FilesMatch "\.(?i:svg)$">
    Require all denied
</FilesMatch>
<Files "padrao.svg">
    Require all granted
</Files>
